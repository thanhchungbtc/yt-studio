# Everything generated lives here: the binary, the database, the asset store,
# coverage and benchmark output.
/var/

# The frontend build overwrites web/dist. A placeholder index.html is committed
# so `go build` works on a fresh clone before npm has ever run; `make clean`
# restores it.
/web/dist/*
!/web/dist/index.html

# Dependencies
/web/node_modules/

# Editors
.DS_Store
.idea/
.vscode/
