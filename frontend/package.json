{
  "name": "yt-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc --noEmit && vite build --minify false --mode development && touch dist/.gitkeep",
    "build": "tsc --noEmit && vite build --mode production && touch dist/.gitkeep",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src",
    "format": "prettier --write --log-level warn \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@wailsio/runtime": "^3.0.0-beta.26",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview": "^8.2.0",
    "dockview-react": "^8.2.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.0.1",
    "tinykeys": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0"
  }
}
