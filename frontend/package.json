{
  "name": "yt-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc --noEmit && vite build --minify false --mode development && touch dist/.gitkeep",
    "build": "tsc --noEmit && vite build --mode production && touch dist/.gitkeep",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src",
    "format": "prettier --write --log-level warn \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@wailsio/runtime": "^3.0.0-beta.26",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview": "^8.4.1",
    "dockview-react": "^8.4.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^2.1.9",
    "react-virtuoso": "^4.18.16",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tinykeys": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.3"
  }
}
