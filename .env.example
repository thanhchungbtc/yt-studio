# yt-studio bootstrap configuration.
#
#   cp .env.example .env    then fill in the keys you need
#
# The server reads .env from the working directory at startup. Set YTS_ENV_FILE
# to load a different one. A variable already set in the real environment always
# wins, so `RUNWARE_KEY=other make run` overrides the file for one run.
#
# This file holds bootstrap values only — the handful of things needed before
# the database is open. Everything else (pool limits, gates, which backend each
# provider port uses, models, prompts, retry policy) is a settings row, edited
# on the settings screen and applied to the next task rather than the next
# restart. Nothing belongs in both places.
#
# Format: KEY=VALUE, one per line. A `#` starts a comment only as the first
# character of a line, so a value may contain one. Surrounding quotes are
# stripped and everything inside them is literal. There is no ${VAR}
# interpolation. A key set twice is an error rather than a silent winner.
#
# The server reads this once, at startup: after changing a key here, restart it.

# --- secrets ----------------------------------------------------------------

# Runware API key, for the `runware` image and thumbnail-icon backends.
# Without it those backends fail at startup's availability check and every
# still fails non-retryably. https://my.runware.ai/keys
RUNWARE_KEY=

# 9router API key, for the `9router` LLM backend. A gateway running with auth
# off needs none, which is the usual local setup.
NINEROUTER_KEY=

# --- endpoints --------------------------------------------------------------

# Where the 9router gateway is listening.
NINEROUTER_URL=http://127.0.0.1:20128

# --- paths and process --------------------------------------------------------
#
# The defaults below are what the binary uses when these are unset. They are
# listed so the file doubles as the inventory of what can be set at all; delete
# any line you are happy with.

# SQLite database file.
YTS_DB=var/yt-studio.db

# Content-addressed asset store root.
YTS_ASSETS=var/assets

# Fixed production assets: background.jpg, chalkboard.jpg, fonts/, sample/.
YTS_RESOURCES=var/resources

# Listen address. 127.0.0.1 keeps a single-operator server off the network.
YTS_LISTEN=127.0.0.1:8080

# Where each LLM prompt and response is written for inspection. Empty disables.
YTS_TRANSCRIPTS=var/transcripts

# Startup log level: debug, info, warn or error. The settings table takes over
# once it is loaded, so this only governs the boot itself.
YTS_LOG_LEVEL=info
